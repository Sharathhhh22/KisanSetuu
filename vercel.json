{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.svg|manifest\\.webmanifest|sw\\.js|index\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
